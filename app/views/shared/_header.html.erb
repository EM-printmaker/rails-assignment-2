<header class="l-header">
    <div class="container-fluid">
      <div class="l-header-container">
        <%= link_to "Potepan Travel", root_path, class: "l-header__logo" %>

        <% if user_signed_in? %>
          <div class="dropdown text-end">
            <a href="#" class="l-header__menu dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
              <%= image_tag current_user.avatar, size: 32, class: "c-avatar" %>
              <span class="l-header__menu--name"><%= current_user.name %></span>
            </a>
            <ul class="dropdown-menu text-small">
              <li><%= link_to "施設の新規登録", new_room_path, class: "dropdown-item" %></li>
              <li><hr class="dropdown-divider"></li>
              <li><%= link_to "予約済み一覧", reservations_path, class: "dropdown-item" %></li>
              <li><%= link_to "登録済み一覧", own_rooms_path, class: "dropdown-item" %></li>
              <li><%= link_to "アカウント設定", "/users/#{current_user.id}", class: "dropdown-item" %></li>
              <li><hr class="dropdown-divider"></li>
              <li><%= link_to "ログアウト", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
            </ul>
          </div>
        <% else %>
          <div class="l-header-button-container">
            <%= link_to "ログイン", new_user_session_path, class: "l-header__text" %>
            <%= link_to "新規登録", new_user_registration_path, class: "btn btn-success l-header__text" %>
          </div>
        <% end %>
      </div>
    </div>
  </header>