<div>
  <div class="p-first-view-container">
    <h2 class="p-first-view__title">
      宿泊先を検索
    </h2>
    <% if flash[:notice] %>
      <div class="c-notice-container hide">
        <p class="c-notice"><%= flash[:notice] %></p>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="c-alert-container hide">
        <p class="c-alert-text"><%= flash[:alert] %></p>
      </div>
    <% end %>
    <%= form_with(url: search_path, method: :get, class: "p-search-form") do |f| %>
      <%= f.text_field :area , class: "form-control", placeholder: "目的地"%>
      <%= f.hidden_field :range, value: "area" %>
      <%= f.submit "検索", class: "btn btn-outline-success" %>
    <% end %>
  </div>
  <div class="l-wrapper">
    <h3>おすすめエリア</h3>
    <div class="c-card-container">
      <%= link_to("/search?area=東京&range=area&commit=検索", class: "p-recommend-area p-recommend-area--tokyo") do %> 
        <span class="p-recommend-area__text">
          <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
          </svg>
          東京
        </span>
      <% end %>
      <%= link_to("/search?area=大阪&range=area&commit=検索", class: "p-recommend-area p-recommend-area--osaka") do %> 
        <span class="p-recommend-area__text">
          <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
          </svg>
          大阪
        </span>
      <% end %>
      <%= link_to("/search?area=京都&range=area&commit=検索", class: "p-recommend-area p-recommend-area--kyoto") do %> 
        <span class="p-recommend-area__text">
          <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
          </svg>
          京都
        </span>
      <% end %>
      <%= link_to("/search?area=札幌&range=area&commit=検索", class: "p-recommend-area p-recommend-area--sapporo") do %> 
        <span class="p-recommend-area__text">
          <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
          </svg>
          札幌
        </span>
      <% end %>
    </div>
  </div>
</div>