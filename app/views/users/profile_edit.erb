<div class="l-wrapper">
  <h2 class="p-user-preference__title u-svg-and-text">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-person-fill-gear" viewBox="0 0 16 16">
      <path d="M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0m-9 8c0 1 1 1 1 1h5.256A4.5 4.5 0 0 1 8 12.5a4.5 4.5 0 0 1 1.544-3.393Q8.844 9.002 8 9c-5 0-6 3-6 4m9.886-3.54c.18-.613 1.048-.613 1.229 0l.043.148a.64.64 0 0 0 .921.382l.136-.074c.561-.306 1.175.308.87.869l-.075.136a.64.64 0 0 0 .382.92l.149.045c.612.18.612 1.048 0 1.229l-.15.043a.64.64 0 0 0-.38.921l.074.136c.305.561-.309 1.175-.87.87l-.136-.075a.64.64 0 0 0-.92.382l-.045.149c-.18.612-1.048.612-1.229 0l-.043-.15a.64.64 0 0 0-.921-.38l-.136.074c-.561.305-1.175-.309-.87-.87l.075-.136a.64.64 0 0 0-.382-.92l-.148-.045c-.613-.18-.613-1.048 0-1.229l.148-.043a.64.64 0 0 0 .382-.921l-.074-.136c-.306-.561.308-1.175.869-.87l.136.075a.64.64 0 0 0 .92-.382zM14 12.5a1.5 1.5 0 1 0-3 0 1.5 1.5 0 0 0 3 0"/>
    </svg>
    設定
  </h2>
  <div class="tabs">
    <ul class="nav nav-tabs nav-fill p-user-preference__nav">
      <li class="nav-item">
        <%= link_to "アカウント", edit_user_registration_path, class: "nav-link"%>
      </li>
      <li class="nav-item">
        <span class="nav-link active" data-bs-toggle="tab" href="#profile">プロフィール</span>
      </li>
    </ul>

    <div class="tab-content p-user-preference__content">
      <div id="profile" class="tab-pane show active">
        <%= form_with(model: @user, class: "form p-user-edit") do |f| %>
          <div class="field p-user-edit__input align-items-center">
            <%= f.label :avatar, class: "p-user-edit__label" %>
            <%= image_tag current_user.avatar, size: 56, class: "c-avatar", id: "imagePreview" %>
            <label class="c-select-button">
              画像をアップロード
              <%= f.file_field :avatar, accept: "image/jpeg,image/gif,image/png", id: "imageInput", class: "u-hidden" %>
            </label>
          </div>
          <div class="field p-user-edit__input">
            <%= f.label :name, class: "p-user-edit__label" %>
            <%= f.text_field :name, class: "form-control" %>
          </div>
          <div class="field p-user-edit__input">
            <%= f.label :self_introduction, class: "p-user-edit__label" %>
            <%= f.text_area :self_introduction,class: "form-control" %>
          </div>
          <div class="actions">
            <%= f.submit "保存する", class: "btn btn-success u-button-width" %>
          </div>
        <% end %>

        <div class="p-user-preference__edit-cancel">
          <%= link_to "/users/#{current_user.id}", class: "btn btn-outline-secondary u-button-width" do %>
            戻る
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<%= javascript_pack_tag 'image/index' %>