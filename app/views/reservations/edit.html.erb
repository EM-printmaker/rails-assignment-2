<div class="l-wrapper">
  <h2 class="">再予約する</h2>
  <div class="p-room-detail__container">
    <%= image_tag @reservation.room.room_image, class: "p-room-detail__image"%>
    <div class="p-room-detail__content">
      <div class="p-room-detail__name-rate">
        <h4><%= @reservation.room.name %></h4>
        <p>¥<%= @reservation.room.rate %>〜</p>
      </div>
      <p><%= @reservation.room.address %></p>
      <% 5.times do %>
        <%= image_pack_tag "star-fill.svg", size: 16%>
      <% end %>
      <p><%= @reservation.room.description %></p>
      <div>
        <%= form_with(model: @reservation, class: "form") do |f| %>
          <div>
            <%= f.label :check_in_date, "チェックイン" %>
            <%= f.date_field :check_in_date, class: "form-control datepicker" %>
          </div>
          <div>
            <%= f.label :check_out_date, "チェックアウト" %>
            <%= f.date_field :check_out_date, class: "form-control datepicker" %>
          </div>
          <div>
            <%= f.label :count, "人数" %>
            <%= f.text_field :count, class: "form-control" %>
          </div>
          <%= f.submit "予約する", class:"btn btn-outline-success u-button-width" %>
        <% end %>
      </div>
      <%= link_to :back, class: "btn btn-outline-secondary u-button-width" do %>
        キャンセル
      <% end %>
    </div>
  </div>
</div>