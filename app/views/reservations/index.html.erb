<div class="l-wrapper">
  <h2 class="">予約済み一覧</h2>
  <% if @reservations.present? %>
    <% @reservations.each do |reservation| %>
      <div class="p-reservations__container">
        <%= render partial: "shared/reservation_card", locals: { reservation: reservation } %>
      </div>
    <% end %>
  <% else %>
    <div class="p-reservations__no-data-container">
      <p>予約は０件です。</p>
      <div class="p-reservations__no-data-search">
        <%= form_with(url: search_path, method: :get, class: "p-search_result__form") do |f| %>
          <%= f.text_field :area , class: "form-control", placeholder: "目的地"%>
          <%= f.text_field :word , class: "form-control", placeholder: "キーワードを入力"%>
          <%= f.submit "検索", class: "btn btn-outline-success" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>