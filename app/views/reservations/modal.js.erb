var reservationModal = document.getElementById('reservationModal');

reservationModal.innerHTML = '<%= escape_javascript(render partial: 'shared/reservation_delete_modal', locals: {reservation: @reservation, room: @room}) %>';

reservationModal.classList.remove('c-modal-hidden');

var myModal = document.getElementById('myModal');
var modalContent = document.getElementById('modalContent');
var modalOpen = document.getElementById('modalOpen');
var cancel = document.getElementById('cancel');

modalOpen.addEventListener('click', () => {
  reservationModal.classList.remove('c-modal-hidden');
});

cancel.addEventListener('click', () => {
  reservationModal.classList.add('c-modal-hidden');
});

myModal.addEventListener('click', () => {
  reservationModal.classList.add('c-modal-hidden');
});

modalContent.addEventListener('click', () => {
  event.stopPropagation();
});
