<div class="p-search-result__header u-search-result__header--border">
  <%= form_with(url: search_path, method: :get, class: "p-search-result__form") do |f| %>
    <%= f.text_field :area , class: "form-control", placeholder: "目的地"%>
    <%= f.text_field :word , class: "form-control", placeholder: "キーワードを入力"%>
    <%= f.submit "検索", class: "btn btn-outline-success" %>
  <% end %>
</div>
<div class="l-wrapper">
  <div class="p-room-detail__header">
    <%= link_to "←戻る", :back, class: "p-room-detail__header--back"%>
    <% if user_signed_in? && current_user.rooms.exists?(id: @room.id) %>
      <%= link_to "編集", edit_room_path(@room.id), class: "p-room-detail__header--back"%>
    <% end %>
  </div>
  <div class="p-room-detail__container">
    <%= image_tag @room.room_image, class: "p-room-detail__image"%>
    <div class="p-room-detail__content">
      <div class="p-room-detail__name-rate">
        <h4><%= @room.name %></h4>
        <p>¥<%= @room.rate.to_s(:delimited) %>〜</p>
      </div>
      <p><%= @room.address %></p>
      <% 5.times do %>
        <%= image_pack_tag "star-fill.svg", size: 16%>
      <% end %>
      <p class="p-room-detail__description"><%= @room.description %></p>
      <div>
        <%= form_with(model: @reservation, url: confirm_reservations_path(@reservation), class: "form p-reservation-form") do |f| %>
          <div class="p-reservation-form__container">
            <div class="p-reservation-form__input-group">
              <%= f.label :check_in_date, "チェックイン" %>
              <%= f.date_field :check_in_date, class: "form-control datepicker" %>
              <% if @reservation.errors.include?(:check_in_date) %>
                <p class="c-error-message"><%= @reservation.errors.full_messages_for(:check_in_date).first %></p>
              <% end %>
            </div>
            <div class="p-reservation-form__input-group">
              <%= f.label :check_out_date, "チェックアウト" %>
              <%= f.date_field :check_out_date, class: "form-control datepicker" %>
              <% if @reservation.errors.include?(:check_out_date) %>
                <p class="c-error-message"><%= @reservation.errors.full_messages_for(:check_out_date).first %></p>
              <% end %>
            </div>
            <div class="p-reservation-form__input-group">
              <%= f.label :count, "人数" %>
              <%= f.text_field :count, class: "form-control" %>
              <% if @reservation.errors.include?(:count) %>
                <p class="c-error-message"><%= @reservation.errors.full_messages_for(:count).first %></p>
              <% end %>
            </div>
          </div>
          <%= f.hidden_field :room_id, value: @room.id %>
          <%= f.submit "予約する", class:"btn btn-success u-button-width" %>
        <% end %>
      </div>
    </div>
  </div>
</div>