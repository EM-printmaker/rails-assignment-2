<div class="l-wrapper">
  <div class="p-room-detail__header">
    <%= link_to "←戻る", :back, class: "p-room-detail__header--back"%>
    <% if user_signed_in? && current_user.rooms.exists?(id: @room.id) %>
      <%= link_to "編集", edit_room_path, class: "p-room-detail__header--back"%>
    <% end %>
  </div>
  <div class="p-room-detail__container">
    <%= image_tag @room.room_image, class: "p-room-detail__image"%>
    <div class="p-room-detail__content">
      <div class="p-room-detail__name-rate">
        <h4><%= @room.name %></h4>
        <p>¥<%= @room.rate.to_s(:delimited) %>〜</p>
      </div>
      <p><%= @room.address %></p>
      <% 5.times do %>
        <%= image_pack_tag "star-fill.svg", size: 16%>
      <% end %>
      <p><%= @room.description %></p>
      <div>
        <%= form_with(model: @reservation, url: confirm_reservations_path(@reservation), class: "form") do |f| %>
          <div>
            <%= f.label :check_in_date, "チェックイン" %>
            <%= f.date_field :check_in_date, class: "form-control datepicker" %>
          </div>
          <div>
            <%= f.label :check_out_date, "チェックアウト" %>
            <%= f.date_field :check_out_date, class: "form-control datepicker" %>
          </div>
          <div>
            <%= f.label :count, "人数" %>
            <%= f.text_field :count, class: "form-control" %>
          </div>
          <%= f.hidden_field :user_id, value: @user.id %>
          <%= f.hidden_field :room_id, value: @room.id %>
          <%= f.submit "予約する", class:"btn btn-success u-button-width" %>
        <% end %>
      </div>
    </div>
  </div>
</div>