<div class="p-search-result__header">
  <%= form_with(url: search_path, method: :get, class: "p-search-result__form") do |f| %>
    <%= f.text_field :area , class: "form-control", placeholder: "目的地"%>
    <%= f.text_field :word , class: "form-control", placeholder: "キーワードを入力"%>
    <%= f.submit "検索", class: "btn btn-outline-success" %>
  <% end %>
</div>
<div class="l-wrapper">
  <p class="p-search-result__count">
    <span class="p-search-result__count--number"><%= @rooms.count %></span>
    件の結果が見つかりました。
  </p>
  <% if @rooms.present? %>
    <% @rooms.each do |room| %>
      <div class="p-own-room__container">
        <%= render partial: "shared/search_card", locals: { room: room } %>
      </div>
    <% end %>
    <% else %>
      <div class="p-own-room__no-data-container">
        <p>データが存在しません。</p>
      </div>
  <% end %>
</div>