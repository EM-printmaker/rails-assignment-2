<div class="l-wrapper">
  <div class="p-user-form">
    <h2 class="p-user-form__title">
      <span class="p-user-form__title--main">Potepan Travel</span>
      <span class="p-user-form__title--sub">へようこそ！</span>
    </h2>
    <p>無料会員登録で様々なサービスを利用できます。</p>
    
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: {class: "form"}) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
    
      <div class="field form-floating">
        <%= f.text_field :name, class: "form-control", id: "floatingInput_1", placeholder: "ユーザー名" %>
        <%= f.label :name, for: "floatingInput_1" %><br />
      </div>

      <div class="field form-floating">
        <%= f.email_field :email, autocomplete: "email", class: "form-control", id: "floatingInput_2", placeholder: "sample@email.com" %>
        <%= f.label :email, for: "floatingInput_2" %><br />
      </div>
    
      <div class="field form-floating">
        <%= f.password_field :password, autocomplete: "new-password", class: "form-control", id: "floatingInput_3", placeholder: "パスワード" %>
        <%= f.label :password, for: "floatingInput_3" %>
      </div>
    
      <div class="field form-floating">
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", id: "floatingInput_4", placeholder: "パスワード再入力" %>
        <%= f.label :password_confirmation, for: "floatingInput_4" %><br />
      </div>
    
      <div class="actions">
        <%= f.submit "新しいアカウントを作成", class: "btn btn-success u-button-width" %>
      </div>
    <% end %>
    
    <%= render "devise/shared/links" %>
  </div>
</div>
